{
  "name": "mecode-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "env:check": "bun run src/scripts/check-env.ts",
    "dev": "bun run env:check && bun run src/dev.ts",
    "build": "bun run env:check && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "firebase-admin": "^13.5.0",
    "hono": "^4.9.9",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "standardwebhooks": "^1.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3"
  }
}
