{
  "name": "mecode",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run dev:server",
    "dev:server": "cd apps/server && bun run dev",
    "dev:cli": "cd apps/cli && bun run dev",
    "cli": "bun --cwd apps/cli ./bin/mocode",
    "cli:start": "bun run cli -- start",
    "cli:status": "bun run cli -- status",
    "cli:pair": "bun run cli -- pair",
    "server:dev": "cd apps/server && bun run dev",
    "server:env:check": "cd apps/server && bun run env:check",
    "server:typecheck": "cd apps/server && bun run typecheck",
    "server:lint": "cd apps/server && bun run lint",
    "cli:lint": "cd apps/cli && bun run lint",
    "db:generate": "cd apps/server && bun run db:generate",
    "db:push": "cd apps/server && bun run db:push",
    "mobile:pub:get": "cd apps/mobile && flutter pub get",
    "mobile:codegen": "cd apps/mobile && dart run build_runner build -d",
    "mobile:run": "cd apps/mobile && flutter run",
    "mobile:lint": "cd apps/mobile && flutter analyze",
    "mobile:apk": "cd apps/mobile && flutter build apk --release",
    "mobile:aab": "cd apps/mobile && flutter build appbundle --release",
    "lint": "bun run server:lint && bun run cli:lint && bun run mobile:lint"
  }
}
